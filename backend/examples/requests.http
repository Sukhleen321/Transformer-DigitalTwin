### GET /api/v1/maintenance/{id}
# GET /api/v1/maintenance/{id}
GET {{baseUrl}}/api/v1/maintenance/{{maintenanceId}}
X-Request-ID: http-demo-example

### PATCH /api/v1/maintenance/{id}
# PATCH /api/v1/maintenance/{id}
PATCH {{baseUrl}}/api/v1/maintenance/{{maintenanceId}}
X-Request-ID: http-demo-example
