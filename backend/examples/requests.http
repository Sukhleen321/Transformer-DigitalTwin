  "status": "DONE"
}

### POST /api/v1/simulate/replay
# POST /api/v1/simulate/replay
POST {{baseUrl}}/api/v1/simulate/replay
X-Request-ID: http-demo-example
Content-Type: application/json

{
  "transformer_id": "TX-HTTP",
  "source_name": "replay-example",
  "records": [
    {
      "transformer_id": "TX-HTTP",
      "timestamp": "2026-01-01T00:00:00Z",
      "phase_voltage_l1": 229.891219,
      "phase_voltage_l2": 229.990258,
      "phase_voltage_l3": 229.620153,
      "current_l1": 85.024504,
      "current_l2": 84.998033,
      "current_l3": 85.260225,
      "neutral_current": 0.262192,
      "oil_temperature": 42.0,
      "winding_temperature": 45.0,
      "ambient_temperature": 22.0,
      "oil_level": 8.0,
      "oil_temp_alarm": 0,
      "oil_temp_trip": 0,
      "magnetic_oil_gauge_alarm": 0,
      "active_power_total": 55.738944,
      "apparent_power_total": 58.672572,
      "reactive_power_total": 18.320505,
      "energy_kwh": 0.464491,
      "power_factor_l1": 0.95,
      "power_factor_l2": 0.95,
      "power_factor_l3": 0.95,
      "source_name": "seed",
      "scenario_id": "SCN_HEALTHY"
    }
  ],
  "speed_multiplier": 0,
  "run_ml": true
}

### GET /api/v1/simulate/replay/{run_id}
# GET /api/v1/simulate/replay/{run_id}
GET {{baseUrl}}/api/v1/simulate/replay/{{runId}}
X-Request-ID: http-demo-example

### POST /api/v1/admin/demo/reset
# POST /api/v1/admin/demo/reset
POST {{baseUrl}}/api/v1/admin/demo/reset?include_transformers=false
X-Request-ID: http-demo-example
X-Admin-Token: {{adminToken}}

### Physics: unavailable unless an explicit supported profile/result exists
# GET /api/v1/transformers/{transformer_id}/physics
GET {{baseUrl}}/api/v1/transformers/TX-001/physics
X-Request-ID: physics-read-example

### Controlled historical cutoff, requiring retained synthetic observations
GET {{baseUrl}}/api/v1/transformers/TX-001/physics?at=2026-10-10T00:00:01Z
X-Request-ID: physics-controlled-example
