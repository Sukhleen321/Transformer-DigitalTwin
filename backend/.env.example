DATABASE_URL=postgresql+psycopg://transformer:transformer@localhost:5432/transformer
ENV=development
PHYSICS_ENABLED=false
# Preferred name for the existing typed live_physics_demo_enabled setting.
# Legacy LIVE_PHYSICS_DEMO_ENABLED remains accepted; preferred name wins
# when both are supplied in one source. The isolated launcher supplies true.
ENABLE_PHYSICS_DEMO=false
PHYSICS_DEMO_INPUT_MODE=standalone
# Isolated full-stack profile uses accepted-telemetry with OPERATIONAL_FLEET_FILE.
# Demo also requires explicit ENV=local-demo and its new disposable DB.
LOG_LEVEL=INFO
SCHEMA_VERSION=1.0.0
DEFAULT_TRANSFORMER_ID=TX-001
ML_BACKEND=stub
ML_HTTP_URL=
ML_PYTHON_ENTRYPOINT=
ML_HISTORY_WINDOW=4096
ML_RUNTIME_WORKERS=1
# H01 Python runtime: set ML_BACKEND=python and ML_PYTHON_ENTRYPOINT=ml.pipeline:analyze.
# Strict mode needs the approved H01 release artifacts. Demo requires explicit opt-in.
ML_RUNTIME_MODE=STRICT_FITTED
ML_ARTIFACT_DIR=
# Run uvicorn with --workers 1. The database runtime lease rejects a second owner.
WEB_CONCURRENCY=1
ML_TIMEOUT_SECONDS=5
ML_MAX_RETRIES=2
MAX_BATCH_SIZE=5000
DEFAULT_WINDOW_HOURS=24
MAX_WINDOW_DAYS=31
MAX_PAGE_LIMIT=5000
DEMO_SOURCE_NAMES=simulator,replay,demo,seed,mqtt,mqtt-simulator,analytics-backfill
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
MQTT_ENABLED=false
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=transformer-backend
MQTT_TOPIC=transformer/+/telemetry
MQTT_QOS=1
MQTT_QUEUE_MAX=10000
MQTT_SOURCE_NAME=mqtt
MQTT_RECONNECT_MIN_S=1
MQTT_RECONNECT_MAX_S=30
# Tests create/drop a disposable database; this account needs CREATEDB.
TEST_DATABASE_URL=postgresql+psycopg://transformer:transformer@localhost:5432/transformer

ALERT_HEALTH_WARN=60
ALERT_HEALTH_CRIT=40
ALERT_ANOMALY_CRITICAL=0.9
ALERT_FAULT_RISK_WARN=0.5
ALERT_FAULT_RISK_CRIT=0.8
ALERT_AUTO_RESOLVE_AFTER=5
ALERT_REASON_SEVERITY={"HIGH_OIL_TEMP":"WARNING","RAPID_TEMP_RISE":"WARNING","OVERLOAD":"WARNING","CURRENT_IMBALANCE":"WARNING","VOLTAGE_IMBALANCE":"WARNING","LOW_OIL_LEVEL":"WARNING","ANOMALOUS_PATTERN":"WARNING"}

# Destructive demo reset is disabled by default; production always refuses it.
DEMO_RESET_ENABLED=false
DEMO_ADMIN_TOKEN=
# Compose-only host ports; keep separate from existing development services.
DEMO_DB_PORT=55433
DEMO_MQTT_PORT=51885
DEMO_HTTP_PORT=8001
DEMO_DB_USER=transformer
DEMO_DB_PASSWORD=transformer
DEMO_DB_NAME=transformer
# Native backend: shared ordered active fleet; scope=all retains legacy registry access.
OPERATIONAL_FLEET_FILE=../simulator/config/operational-fleet.json
