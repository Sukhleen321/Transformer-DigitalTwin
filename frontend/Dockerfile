FROM node:24-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci --ignore-scripts
COPY frontend ./
ARG VITE_API_BASE_URL=http://127.0.0.1:8001
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ARG VITE_LIVE_PHYSICS_DEMO_ENABLED=false
ARG VITE_LIVE_PHYSICS_POLL_INTERVAL_MS=4000
ENV VITE_LIVE_PHYSICS_DEMO_ENABLED=$VITE_LIVE_PHYSICS_DEMO_ENABLED
ENV VITE_LIVE_PHYSICS_POLL_INTERVAL_MS=$VITE_LIVE_PHYSICS_POLL_INTERVAL_MS
RUN npm run build
FROM nginx:1.28-alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
