# API origin (without /api/v1). Vite dev is normally http://localhost:5173.
VITE_API_BASE_URL=http://127.0.0.1:8001
# Demo polling is clamped to 2000–5000 ms.
VITE_POLL_INTERVAL_MS=3000
# Configured demo event-age threshold; not a universal operational limit.
VITE_STALE_AFTER_MS=10000


# Optional Vite-only same-origin mode: VITE_API_BASE_URL=/
# The dev proxy forwards /api to the existing loopback backend on port 8001.

# Separate live physics demo: default disabled. Prefer the isolated launcher,
# which sets these and VITE_API_BASE_URL for its OWN frontend process only.
VITE_LIVE_PHYSICS_DEMO_ENABLED=false
VITE_LIVE_PHYSICS_POLL_INTERVAL_MS=4000
